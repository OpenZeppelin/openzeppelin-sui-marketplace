{
  "name": "dapp",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Oracle Market",
  "scripts": {
    "bootstrap:localnet": "./scripts/bootstrap-localnet.sh",
    "bootstrap:testnet": "./scripts/bootstrap-testnet.sh",
    "ui": "pnpm --filter ui",
    "script": "pnpm --filter dapp",
    "dapp": "pnpm --filter dapp",
    "learn": "pnpm --filter learn",
    "tooling": "pnpm --filter tooling",
    "typecheck": "tsc -b",
    "lint": "eslint \"packages/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\"",
    "lint:fix": "eslint --fix \"packages/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.15",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "packages/*/*"
  ],
  "pnpm": {
    "overrides": {
      "axios": "1.18.1",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "sharp@<0.35.0": "0.35.3",
      "@isaacs/brace-expansion": "5.0.1",
      "brace-expansion@>=5.0.0 <5.0.8": "5.0.8",
      "minimatch": "10.2.4",
      "next@>=16.0.0-beta.0 <16.2.11": "16.2.11",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "@xmldom/xmldom@>=0.9.0 <0.9.9": "0.9.9",
      "lodash-es@>=4.0.0 <=4.17.23": "4.18.1",
      "vite@>=7.0.0 <7.3.5": "7.3.5",
      "vitest@<3.2.6": "3.2.6",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "js-cookie@<3.0.7": "3.0.7",
      "follow-redirects@<=1.15.11": ">=1.16.0",
      "dompurify@<=3.3.3": ">=3.4.0",
      "@xmldom/xmldom@>=0.9.0 <0.9.10": ">=0.9.10",
      "uuid@<14.0.0": ">=14.0.0",
      "postcss@<8.5.18": ">=8.5.18",
      "dompurify@<3.4.0": ">=3.4.0",
      "dompurify@>=1.0.10 <3.4.0": ">=3.4.0",
      "dompurify@>=3.0.1 <3.4.0": ">=3.4.0"
    }
  }
}
